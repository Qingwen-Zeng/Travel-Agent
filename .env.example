# Copy this file to .env and fill in real values. .env is git-ignored.

# Path to the SQLite database file read by the web application.
DATABASE_PATH=travel.db

# Google Maps JavaScript API key. Sent to the browser, so it is public by nature.
# Restrict it in the Google Cloud console to your site's domain (HTTP referrers) and
# to the Maps JavaScript API only.
GOOGLE_MAPS_BROWSER_KEY=

# Google Maps Map ID, required for Advanced Markers.
GOOGLE_MAPS_MAP_ID=

# LLM provider API key (Anthropic).
LLM_API_KEY=

# LLM model identifier, e.g. claude-sonnet-4-5.
LLM_MODEL=

# Per-IP chat message cap, per hour.
RATE_LIMIT_PER_HOUR=10

# Site-wide chat message cap, per calendar day.
DAILY_MESSAGE_CAP=300

# --- Offline scripts only. Never loaded by the web application. ---
# Server-side Google Places API key, restricted to the Places API. Used by
# scripts/import_saved_places.py (geocoding) and scripts/enrich_places.py (ratings,
# contact info, photos), both run on the owner's machine.
GOOGLE_PLACES_API_KEY=
